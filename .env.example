# Copy to .env.local and fill in values. Never commit .env.local.

# MongoDB Atlas — copy full string from Atlas → Connect → Drivers (must match cluster hostname exactly)
# Example shape: mongodb+srv://USER:PASS@cluster0.XXXXX.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGODB_URI=

# openssl rand -base64 32 — required for login sessions (Vercel: set in Production env)
AUTH_SECRET=

# Canonical URL — required for NextAuth on Vercel (no trailing slash)
AUTH_URL=https://www.musiccityscavengerhunt.com
NEXT_PUBLIC_APP_URL=https://www.musiccityscavengerhunt.com

# Stripe — Dashboard → Developers → API keys (live mode for production)
# Secret: sk_live_... OR restricted rk_live_ with Checkout Sessions read/write
STRIPE_SECRET_KEY=
# Publishable: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Apple Pay / Google Pay: Stripe Dashboard → Settings → Payment methods (enable both).
# Apple Pay: register https://www.musiccityscavengerhunt.com under Apple Pay → Domains.
# Wallets only show on supported devices (e.g. Safari/iPhone for Apple Pay, Chrome for Google Pay).

# Stripe — Dashboard → Developers → Webhooks → endpoint
# URL: https://www.musiccityscavengerhunt.com/api/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Seed admin (npm run seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CONTACT_TO_EMAIL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
